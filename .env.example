# ─── LLM recipe extraction (strongly recommended) ───────────────────────────
# Handles ad-heavy / paywalled / multi-component recipe pages.
# Get a key: https://console.x.ai  →  set XAI_API_KEY
# SpaceXAI / xAI OpenAI-compatible API (default model grok-4.5)
XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.5
#
# Optional OpenAI-compatible fallback if you prefer another host later:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ─── GitHub integration (optional) ───────────────────────────────────────────
# Create a Personal Access Token at https://github.com/settings/tokens
# Required scopes: repo (for private) or public_repo (for public repos)
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Repository in owner/repo format — replace with YOUR repo
GITHUB_REPO=RegularJoe-CEO/recipe-cards

# Branch to push into (default: main)
GITHUB_BRANCH=main

# Optional: path prefix inside the repo (default: recipes/)
GITHUB_PATH_PREFIX=recipes/
